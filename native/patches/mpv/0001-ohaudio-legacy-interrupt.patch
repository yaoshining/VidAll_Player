+// 旧回调只持有不复用的数字标识。读锁保护在途回调，注销后迟到的回调查不到 AO。
+static pthread_rwlock_t legacy_lock = PTHREAD_RWLOCK_INITIALIZER;
+static struct legacy_binding *legacy_bindings;
+static uintptr_t last_legacy_token;
+
+static void *bind_legacy(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    pthread_rwlock_wrlock(&legacy_lock);
+    if (last_legacy_token != UINTPTR_MAX) {
+        p->legacy = (struct legacy_binding){++last_legacy_token, ao, legacy_bindings};
+        legacy_bindings = &p->legacy;
+    }
+    pthread_rwlock_unlock(&legacy_lock);
+    return (void *)p->legacy.token;
+}
+
+static struct ao *lookup_legacy(void *user)
+{
+    for (struct legacy_binding *b = legacy_bindings; b; b = b->next) {
+        if (b->token == (uintptr_t)user)
+            return b->ao;
+    }
+    return NULL;
+}
+
+static void unbind_legacy(struct priv *p)
+{
+    if (!p->legacy.token)
+        return;
+    pthread_rwlock_wrlock(&legacy_lock);
+    struct legacy_binding **link = &legacy_bindings;
+    while (*link != &p->legacy)
+        link = &(*link)->next;
+    *link = p->legacy.next;
+    p->legacy = (struct legacy_binding){0};
+    pthread_rwlock_unlock(&legacy_lock);
+}
