diff --git a/audio/out/ao_ohaudio.c b/audio/out/ao_ohaudio.c
index 5010eef..63c096a 100644
--- a/audio/out/ao_ohaudio.c
+++ b/audio/out/ao_ohaudio.c
@@ -27,6 +27,7 @@
 #include "osdep/threads.h"
 #include "osdep/timer.h"
 
+#include <deviceinfo.h>
 #include <ohaudio/native_audiorenderer.h>
 #include <ohaudio/native_audiostreambuilder.h>
 
@@ -129,6 +130,35 @@ static OH_AudioData_Callback_Result audio_on_write_callback(
     return AUDIO_DATA_CALLBACK_RESULT_VALID;
 }
 
+static int32_t legacy_write(OH_AudioRenderer *renderer, void *user, void *data, int32_t size)
+{
+    audio_on_write_callback(renderer, user, data, size);
+    return 0;
+}
+
+static int32_t legacy_interrupt(OH_AudioRenderer *renderer, void *user,
+                                OH_AudioInterrupt_ForceType type, OH_AudioInterrupt_Hint hint)
+{
+    if (hint == AUDIOSTREAM_INTERRUPT_HINT_PAUSE || hint == AUDIOSTREAM_INTERRUPT_HINT_STOP)
+        ao_request_pause(user);
+    return 0;
+}
+
+static OH_AudioStream_Result register_callbacks(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (OH_GetSdkApiVersion() >= 20)
+        return OH_AudioStreamBuilder_SetRendererWriteDataCallback(p->builder, audio_on_write_callback, ao);
+
+    // 旧系统必须一次注册两种回调，分别注册可能覆盖先前的写入回调。
+    ao->per_file = true;
+    OH_AudioRenderer_Callbacks callbacks = {
+        .OH_AudioRenderer_OnWriteData = legacy_write,
+        .OH_AudioRenderer_OnInterruptEvent = legacy_interrupt,
+    };
+    return OH_AudioStreamBuilder_SetRendererCallback(p->builder, callbacks, ao);
+}
+
 static int init(struct ao* ao)
 {
     struct priv* p = ao->priv;
@@ -176,8 +206,11 @@ static int init(struct ao* ao)
         break;
     }
 
-    OH_AudioRenderer_OnWriteDataCallback callback = audio_on_write_callback;
-    OH_AudioStreamBuilder_SetRendererWriteDataCallback(p->builder, callback, ao);
+    res = register_callbacks(ao);
+    if (res != AUDIOSTREAM_SUCCESS) {
+        MP_ERR(ao, "Fail to register renderer callbacks: error code %d.\n", res);
+        goto error;
+    }
 
     res = OH_AudioStreamBuilder_GenerateRenderer(p->builder, &p->renderer);
 
