     mp_wakeup_core(mpctx);
 }
 
+static void handle_audio_interrupt(struct MPContext *mpctx)
+{
+    if (mpctx->ao && ao_query_and_reset_events(mpctx->ao, AO_EVENT_PAUSE) && !mpctx->opts->pause) {
+        // 播放线程修改 pause，随文件卸载恢复；解除打断本身不恢复播放。
+        m_config_backup_opt(mpctx->mconfig, "pause");
+        set_pause_state(mpctx, true);
+    }
+}
+
 void fill_audio_out_buffers(struct MPContext *mpctx)
 {
     struct MPOpts *opts = mpctx->opts;
 
+    handle_audio_interrupt(mpctx);
     if (mpctx->ao && ao_query_and_reset_events(mpctx->ao, AO_EVENT_RELOAD))
         reload_audio_output(mpctx);
 
