+// 仅用于不可恢复的 owner 故障。由 client 锁保护，独立于队列容量和事件 mask。
+void mp_client_broadcast_critical(struct mp_client_api *api, int event, void *data)
+{
+    mp_mutex_lock(&api->lock);
+    for (int n = 0; n < api->num_clients; n++) {
+        struct mpv_handle *ctx = api->clients[n];
+        mp_mutex_lock(&ctx->lock);
+        if (!ctx->critical_event.event_id) {
+            ctx->critical_event = (mpv_event){.event_id = event, .data = data};
+            dup_event_data(&ctx->critical_event);
+            talloc_steal(ctx, ctx->critical_event.data);
+        }
+        wakeup_client(ctx);
+        mp_mutex_unlock(&ctx->lock);
+    }
+    mp_mutex_unlock(&api->lock);
+}
+
+static bool gen_critical_event(struct mpv_handle *ctx)
+{
+    if (!ctx->critical_event.event_id)
+        return false;
+    *ctx->cur_event = ctx->critical_event;
+    talloc_steal(ctx->cur_event, ctx->cur_event->data);
+    ctx->critical_event = (mpv_event){0};
+    return true;
+}
