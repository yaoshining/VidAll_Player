+            if (b->in_flight != UINT_MAX) {
+                b->in_flight++;
+                found = b;
+            }
+            break;
+        }
     }
-    return NULL;
+    pthread_mutex_unlock(&legacy_lock);
+    return found;
 }
 
+static void release_legacy(struct legacy_binding *binding)
+{
+    pthread_mutex_lock(&legacy_lock);
+    if (--binding->in_flight == 0)
+        pthread_cond_broadcast(&legacy_idle);
+    pthread_mutex_unlock(&legacy_lock);
+}
+
 static void unbind_legacy(struct priv *p)
 {
-    if (!p->legacy.token)
-        return;
-    pthread_rwlock_wrlock(&legacy_lock);
-    struct legacy_binding **link = &legacy_bindings;
-    while (*link != &p->legacy)
-        link = &(*link)->next;
-    *link = p->legacy.next;
-    p->legacy = (struct legacy_binding){0};
-    pthread_rwlock_unlock(&legacy_lock);
+    pthread_mutex_lock(&legacy_lock);
+    if (p->legacy.token) {
+        struct legacy_binding **link = &legacy_bindings;
+        while (*link && *link != &p->legacy)
+            link = &(*link)->next;
+        if (*link)
+            *link = p->legacy.next;
+        // 先撤销查找，再仅等本 AO 的在途回调；等待会释放全局锁。
+        // 不能以超时为由返回并释放仍在使用的 AO。
+        while (p->legacy.in_flight)
+            pthread_cond_wait(&legacy_idle, &legacy_lock);
+        p->legacy = (struct legacy_binding){0};
+    }
+    pthread_mutex_unlock(&legacy_lock);
 }
 
