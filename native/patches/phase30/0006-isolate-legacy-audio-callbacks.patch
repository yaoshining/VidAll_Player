+static pthread_mutex_t legacy_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t legacy_idle = PTHREAD_COND_INITIALIZER;
 static struct legacy_binding *legacy_bindings;
 static uintptr_t last_legacy_token;
 
