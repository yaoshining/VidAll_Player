+// 未归还的平台资源及操作线程共同占用名额，只有正常销毁才能释放。
+static atomic_uint isolated_owners;
+
+void ohcodec_owner_fault(struct ra_hwdec *hw, int error, int stage)
+{
+    struct ohcodec_priv *owner = hw->priv;
+    if (!owner->isolated || !hw->global->client_api)
+        mp_ohcodec_terminal_enter(error, stage, (uintptr_t)hw);
+    char err[24], phase[24];
+    snprintf(err, sizeof(err), "%d", error);
+    snprintf(phase, sizeof(phase), "%d", stage);
+    char *args[] = {"vidall-ohcodec-quarantined", phase, err};
+    mpv_event_client_message event = {.num_args = 3, .args = (const char **)args};
+    mp_client_broadcast_event_external(hw->global->client_api, MPV_EVENT_CLIENT_MESSAGE, &event);
+    // 留在当前栈上，父级不能继续销毁 Vulkan 设备、Surface 或解码器。
+    static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
+    static pthread_cond_t parked = PTHREAD_COND_INITIALIZER;
+    pthread_mutex_lock(&mutex);
+    for (;;)
+        pthread_cond_wait(&parked, &mutex);
+}
+
+static void release_slot(struct ohcodec_priv *p)
+{
+    if (p->isolated) {
+        p->isolated = false;
+        atomic_fetch_sub(&isolated_owners, 1);
+    }
+}
+
 static int init(struct ra_hwdec *hw)
 {
     struct ohcodec_priv *p = hw->priv;
 
+    if (hw->ra_ctx->vo && hw->ra_ctx->vo->opts->ohcodec_session_isolation) {
+        unsigned count = atomic_load(&isolated_owners);
+        do {
+            if (count >= 2)
+                return -1;
+        } while (!atomic_compare_exchange_weak(&isolated_owners, &count, count + 1));
+        p->isolated = true;
+    }
     for (int i = 0; interop_inits[i] && !p->surface; i++)
         interop_inits[i](hw);
 
     if (!p->surface || !p->interop) {
+        release_slot(p);
         MP_VERBOSE(hw, "OHCodec Surface hwdec requires compatible GL or Vulkan.\n");
         return -1;
     }
