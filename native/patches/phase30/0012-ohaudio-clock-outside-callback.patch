 static void reset_timing(struct priv *p)
 {
+    if (!p->timing_initialized) return;
+    mp_mutex_lock(&p->timing_lock);
     p->last_query = 0;
     p->frame_position = 0;
     p->frame_timestamp = 0;
     p->written_frames = 0;
     p->queued_frames = 0;
     p->timestamp_valid = false;
+    mp_cond_signal(&p->timing_wakeup);
+    mp_mutex_unlock(&p->timing_lock);
+}
+
+// 每个已登记音频槽最多一个采样线程，和槽一起保留或释放；不为重试另起线程。
+// 查询与控制/关闭共用同一槽锁，但绝不在平台写回调内调用 Renderer API。
+static void *timing_worker(void *opaque)
+{
+    struct ao *ao = opaque;
+    struct priv *p = ao->priv;
+    for (;;) {
+        mp_mutex_lock(&p->timing_lock);
+        bool stop = p->timing_stop;
+        mp_mutex_unlock(&p->timing_lock);
+        if (stop || !mp_host_audio_control_lock(p->recovery_token)) break;
+        mp_mutex_lock(&p->timing_lock);
+        stop = p->timing_stop;
+        mp_mutex_unlock(&p->timing_lock);
+        if (!stop) {
+            int64_t position, timestamp;
+            OH_AudioStream_Result result = OH_AudioRenderer_GetAudioTimestampInfo(
+                p->renderer, &position, &timestamp);
+            // 查询可能耗时；不能用进入查询前的时间检查返回值或推算播放时刻。
+            int64_t now = mp_time_ns();
+            mp_mutex_lock(&p->timing_lock);
+            if (!p->timing_stop && result == AUDIOSTREAM_SUCCESS && position >= 0 &&
+                timestamp > 0 && timestamp <= now && now - timestamp < MP_TIME_S_TO_NS(2)) {
+                if (p->last_query && position < p->frame_position)
+                    p->written_frames = position;
+                p->frame_position = position;
+                p->frame_timestamp = timestamp;
+                p->timestamp_valid = true;
+            }
+            p->last_query = now;
+            mp_mutex_unlock(&p->timing_lock);
+        }
+        mp_host_audio_control_unlock(p->recovery_token);
+        if (stop) break;
+        mp_mutex_lock(&p->timing_lock);
+        if (!p->timing_stop)
+            mp_cond_timedwait(&p->timing_wakeup, &p->timing_lock, MP_TIME_MS_TO_NS(250));
+        stop = p->timing_stop;
+        mp_mutex_unlock(&p->timing_lock);
+        if (stop) break;
+    }
+    return NULL;
+}
+
+static void stop_timing_worker(struct priv *p)
+{
+    if (!p->timing_initialized) return;
+    mp_mutex_lock(&p->timing_lock);
+    p->timing_stop = true;
+    mp_cond_broadcast(&p->timing_wakeup);
+    mp_mutex_unlock(&p->timing_lock);
+    // 查询未返回时保留AO、renderer、线程及槽，不并发Release或强行取消线程。
+    if (p->timing_started) {
+        pthread_join(p->timing_thread, NULL);
+        p->timing_started = false;
+    }
 }
 
 static int release_for_recovery(void *opaque)
