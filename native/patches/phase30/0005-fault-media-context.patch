+#if HAVE_OHOS
+int mpv_host_loadfile_async(mpv_handle *ctx, uint64_t generation, uint64_t session_id, const char **args)
+{
+    if (!ctx || !generation || !session_id || !args || !args[0] || strcmp(args[0], "loadfile"))
+        return MPV_ERROR_INVALID_PARAMETER;
+    unsigned long long expected = 0;
+    if (!atomic_compare_exchange_strong(&ctx->mpctx->global->host_session_id, &expected, session_id) &&
+        expected != session_id)
+        return MPV_ERROR_INVALID_PARAMETER;
+    struct mp_cmd *cmd = mp_input_parse_cmd_strv(ctx->log, args);
+    if (!cmd) return MPV_ERROR_INVALID_PARAMETER;
+    cmd->host_load_generation = generation;
+    return run_async_cmd(ctx, generation, cmd);
+}
+#endif
+
 int mpv_command_async(mpv_handle *ctx, uint64_t ud, const char **args)
 {
     return run_async_cmd(ctx, ud, mp_input_parse_cmd_strv(ctx->log, args));
