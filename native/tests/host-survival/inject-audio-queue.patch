+struct probe_queue_trace { struct probe_queue_row rows[64]; };
+static void probe_record(struct probe_queue_trace *t, unsigned n,
+    int64_t enter, int64_t leave, int64_t samples, int64_t written,
+    int64_t queued, int64_t pos, int64_t stamp, int64_t end, int64_t nonzero)
+{
+    if (n >= 64) return;
+    struct probe_queue_row *r = &t->rows[n];
+    r->enter=enter; r->leave=leave; r->samples=samples; r->written=written;
+    r->queued=queued; r->pos=pos; r->stamp=stamp; r->end=end; r->nonzero=nonzero;
+    atomic_store_explicit(&r->ready,true,memory_order_release);
+}
+// T066_TRACE_END
