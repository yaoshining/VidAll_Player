# 兼容维护分支固定现用 HAR 的运行库，不随构建机 SDK 升级而替换。
function(vidall_check_legacy_runtime runtime architecture stl)
  if(NOT stl STREQUAL "none")
    message(FATAL_ERROR "旧基线要求 OHOS_STL=none，禁止 SDK 自动注入运行库")
  endif()
  if(architecture STREQUAL "arm64-v8a")
    set(expected "9b67147034bfc1d2b7b51b97b638713f90bd8ca9cf4acbcdac6cbc6d155f6042")
  elseif(architecture STREQUAL "x86_64")
    set(expected "c65b4e92e52bdbf170d0c11a02c2e3b280fd140c4b8a764e40d8d4875e5ce944")
  else()
    message(FATAL_ERROR "旧基线未验收该 ABI")
  endif()
  if(NOT EXISTS "${runtime}")
    message(FATAL_ERROR "旧基线运行库缺失")
  endif()
  file(SHA256 "${runtime}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "旧基线运行库 SHA256 不匹配")
  endif()
endfunction()
