# 仅独立评估target启用；默认target继续使用其既有工具链配置。
function(vidall_check_fixed_runtime runtime architecture stl)
  if(NOT VIDALL_FIXED_CXX_RUNTIME)
    return()
  endif()
  if(architecture STREQUAL "arm64-v8a")
    set(expected "9b67147034bfc1d2b7b51b97b638713f90bd8ca9cf4acbcdac6cbc6d155f6042")
  elseif(architecture STREQUAL "x86_64")
    set(expected "a411fee450ad8e60ee12a3b282d3609f9623307b3f6d2b244e1428091cf54603")
  else()
    message(FATAL_ERROR "固定runtime不支持此架构")
  endif()
  if(NOT stl STREQUAL "none")
    message(FATAL_ERROR "固定runtime评估要求OHOS_STL=none，禁止SDK自动注入runtime")
  endif()
  if(NOT EXISTS "${runtime}")
    message(FATAL_ERROR "固定runtime不存在")
  endif()
  file(SHA256 "${runtime}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "固定runtime SHA256不匹配")
  endif()
endfunction()
