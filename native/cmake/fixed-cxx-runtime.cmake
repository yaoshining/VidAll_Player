# 仅独立评估target启用；默认target继续使用其既有工具链配置。
function(vidall_check_fixed_runtime runtime architecture stl)
  if(NOT VIDALL_FIXED_CXX_RUNTIME)
    return()
  endif()
  if(NOT architecture STREQUAL "arm64-v8a")
    message(FATAL_ERROR "固定runtime评估仅允许ARM64")
  endif()
  if(NOT stl STREQUAL "none")
    message(FATAL_ERROR "固定runtime评估要求OHOS_STL=none，禁止SDK自动注入runtime")
  endif()
  if(NOT EXISTS "${runtime}")
    message(FATAL_ERROR "固定runtime不存在")
  endif()
  file(SHA256 "${runtime}" actual)
  if(NOT actual STREQUAL "9b67147034bfc1d2b7b51b97b638713f90bd8ca9cf4acbcdac6cbc6d155f6042")
    message(FATAL_ERROR "固定runtime SHA256不匹配")
  endif()
endfunction()
