# HarmonyOS / Hvigor
.hvigor/
**/.hvigor/
**/build/
**/.cxx/
**/.externalNativeBuild/

# Native build output and local source cache
dist/
.cache/
oh_modules/

# IDE and local settings
.idea/
.vscode/
.DS_Store
*.log

# Candidate release evidence (directory placeholders are tracked)
release/**
!release/**/.gitkeep
!release/audits/har-native-packaging-spike.json
!release/audits/tdd-baseline.json
!release/audits/candidate-readiness.json
!release/audits/final-hvigor-build.json
!release/audits/vidall-tv-isolation.json
!release/audits/api-compatibility-gate.json
!release/audits/quickstart-validation.json
!release/capabilities/arm64-tv-evidence.json
!release/capabilities/arm64-tv-media-matrix.json
!release/capabilities/phone-demo-evidence.json
!release/manifests/release-manifest.json
# Generated HAR compatibility source
packages/vidall-player/BuildProfile.ets

# Keep the required empty boundary directories under version control
!scripts/build/
!scripts/build/.gitkeep
!release/
!release/**/
!release/**/.gitkeep
!release/capabilities/arm64-tv-capability-evidence.json
!release/capabilities/arm64-tv-streaming-proxy.json
!release/capabilities/evidence/
!release/capabilities/evidence/**

# HarmonyOS signing certificates
signing/*
!signing/README.md
.reproducible-cache/
examples/consumer-smoke/oh_modules/
examples/consumer-smoke/oh-package-lock.json5
